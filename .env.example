# Voice Assistant Agent Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Choose Active Model Provider:
# Options: 'gemini' | 'groq' | 'openai' | 'anthropic' | 'ollama'
MODEL_PROVIDER=gemini

# Specific model name (Optional, leaves blank to use provider default)
# Examples:
#   Gemini: gemini-1.5-flash | gemini-2.0-flash
#   Groq:   llama-3.3-70b-versatile | llama-3.1-8b-instant
#   OpenAI: gpt-4o-mini | gpt-4o
#   Ollama: llama3.2 | qwen2.5
MODEL_NAME=

# Set API Credentials for your chosen provider:
# 1. Google Gemini (Free at https://aistudio.google.com)
GEMINI_API_KEY=

# 2. Groq Cloud (Free at https://console.groq.com)
GROQ_API_KEY=

# 3. OpenAI
OPENAI_API_KEY=

# 4. Anthropic Claude
ANTHROPIC_API_KEY=

# 5. Local Ollama (No API key needed)
OLLAMA_BASE_URL=http://localhost:11434

# Path to Domain Knowledge Markdown File
DOMAIN_KNOWLEDGE_FILE=./data/domain_knowledge.md
